# ─────────────────────────────────────────────────────────────────────────────
# TAMBULA MENGO ENVIRONMENT VARIABLES (.env)
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL for frontend client (e.g. http://localhost:8000 in dev or https://api.tambulamengo.work.gd in prod)
VITE_BACKEND_URL=http://localhost:8000
VITE_USE_DJANGO=true

# Optional Supabase Configuration
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Django Backend Configuration
DJANGO_SECRET_KEY=change-this-in-production-secret-key-12345
DEBUG=True
FRONTEND_URL=http://localhost:8080
