# ─────────────────────────────────────────────────────────────────────────────
# TAMBULA MENGO BACKEND ENVIRONMENT VARIABLES (.env)
# ─────────────────────────────────────────────────────────────────────────────

# Django Secret Key
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-12345

# Debug mode (Set False in Production)
DEBUG=False

# Allowed Origins / Domain
FRONTEND_URL=https://tambulamengo.work.gd

# ─────────────────────────────────────────────────────────────────────────────
# 📱 EGOSMS UGANDA INTEGRATION CREDENTIALS
# (Obtain from EgoSMS Uganda Portal: https://www.egosms.co)
# ─────────────────────────────────────────────────────────────────────────────
EGOSMS_USERNAME=your_egosms_username
EGOSMS_PASSWORD=your_egosms_password
EGOSMS_SENDER_ID=TambulaMengo

# ─────────────────────────────────────────────────────────────────────────────
# 💰 YO! PAYMENTS UGANDA INTEGRATION CREDENTIALS
# (Obtain from Yo! Payments Account: https://payments.yo.co.ug)
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_GATEWAY=yo
YO_PAYMENTS_API_USERNAME=your_yo_payments_username
YO_PAYMENTS_API_PASSWORD=your_yo_payments_password
YO_PAYMENTS_SANDBOX=False

# ─────────────────────────────────────────────────────────────────────────────
# 💳 PESAPAL V3 INTEGRATION CREDENTIALS (OPTIONAL BACKUP)
# ─────────────────────────────────────────────────────────────────────────────
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_SANDBOX=False
